{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // `app.config.ts` imports `./src/theme/colors.ts` with its extension: Expo's
    // config loader resolves TypeScript only when the specifier spells it out.
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["jest"],
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules", "dist", "backlog"]
}

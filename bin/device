#!/usr/bin/env bash
# Put the emulator into the device states the acceptance criteria describe.
#
#   bin/device geo <lat> <lon>     move the device (natural lat/lon order)
#   bin/device gps on|off          location services master switch
#   bin/device net on|off          connectivity, via airplane mode
#   bin/device slow|fast           degrade/restore the mobile network
#   bin/device perm grant|revoke|deny-forever|reset   location permission for the app
#   bin/device font <scale>|max|reset    OS font scale (Settings > Display)
#   bin/device finger              present an enrolled fingerprint
#   bin/device finger enroll|clear|status   the enrolment behind it
#   bin/device link <url>          open a kolvi:// deep link
#   bin/device launch|kill         start or force-stop the app
#   bin/device state               report the above as a summary
source "$(dirname "${BASH_SOURCE[0]}")/_common.sh"
require_device

LOCATION_PERMS=(android.permission.ACCESS_FINE_LOCATION android.permission.ACCESS_COARSE_LOCATION)

# The device credential the emulator's biometric enrolment sits on top of.
# Android will not enrol a fingerprint without one, and `disableDeviceFallback:
# false` in src/features/auth/biometrics.ts means the app's prompt falls back to
# exactly this PIN — so a flow that exercises the fallback types 1111.
DEVICE_PIN=1111

ui_xml() {
  "$ADB" shell uiautomator dump /sdcard/ui.xml >/dev/null 2>&1
  "$ADB" exec-out cat /sdcard/ui.xml
}

# Tap a control by its label, resolving the coordinates from the hierarchy rather
# than hardcoding them — the enrolment screens differ between system images and
# between screen sizes, and a fixed point silently taps the wrong thing.
tap_text() {
  local label="$1" bounds x1 y1 x2 y2
  bounds="$(ui_xml | grep -oP "text=\"$label\"[^>]*bounds=\"\K[^\"]+" | head -1)"
  [ -n "$bounds" ] || return 1

  # `bounds` is `[x1,y1][x2,y2]`. Pulling the four integers out is steadier than
  # unpicking the brackets and commas.
  read -r x1 y1 x2 y2 <<<"$(echo "$bounds" | grep -oP '\d+' | tr '\n' ' ')"

  "$ADB" shell input tap $(( (x1 + x2) / 2 )) $(( (y1 + y2) / 2 ))
}

# Substring, not the whole attribute: the wizard's headings carry trailing copy
# ("Enter your PIN to continue"), and matching the attribute exactly misses them.
on_screen() { ui_xml | grep -oP 'text="\K[^"]*' | grep -qF -- "$1"; }

# Scroll the enrolment consent page until its button is reachable. The copy runs
# past a screen on a phone-sized AVD, and the button is below all of it.
scroll_to_text() {
  local label="$1" i
  for i in $(seq 1 8); do
    on_screen "$label" && return 0
    "$ADB" shell input swipe 500 1500 500 400 300
    sleep 1
  done
  on_screen "$label"
}

finger_count() {
  "$ADB" shell dumpsys fingerprint 2>/dev/null \
    | grep -oP '"count":\K[0-9]+' | head -1 | tr -d '\r'
}

# Walk Settings' enrolment wizard, because there is no adb command for it:
# `adb emu finger touch` presents a finger to a sensor that has nothing to match
# it against until this has run. Idempotent — a second call is a no-op.
finger_enroll() {
  local enrolled
  enrolled="$(finger_count)"
  if [ "${enrolled:-0}" -gt 0 ]; then
    echo "already enrolled: ${enrolled} fingerprint(s)"
    return 0
  fi

  # Tolerated rather than checked: a PIN that is already set makes this fail, and
  # that is the state the next step wants anyway.
  "$ADB" shell locksettings set-pin "$DEVICE_PIN" >/dev/null 2>&1 || true

  # Force-stopped first: a Settings already sitting on one of these screens
  # swallows the intent ("delivered to currently running top-most instance") and
  # leaves the wizard wherever the last attempt abandoned it.
  "$ADB" shell am force-stop com.android.settings >/dev/null 2>&1 || true
  "$ADB" shell am start -a android.settings.FINGERPRINT_ENROLL >/dev/null
  sleep 3

  if on_screen 'Enter your PIN'; then
    "$ADB" shell input text "$DEVICE_PIN"
    "$ADB" shell input keyevent 66
    sleep 3
  fi

  scroll_to_text 'I AGREE' || die "the enrolment consent page never appeared"
  tap_text 'I AGREE' || die "could not reach the consent button"
  sleep 3

  # Each touch is one of the several images the wizard asks for; it decides when
  # it has enough, so the loop watches the count rather than counting touches.
  local i
  for i in $(seq 1 40); do
    "$ADB" emu finger touch 1 >/dev/null 2>&1 || true
    sleep 0.6
    [ "$(finger_count)" -gt 0 ] && break
  done

  [ "$(finger_count)" -gt 0 ] || die "enrolment did not take — see bin/shot for the screen"

  tap_text 'DONE' >/dev/null 2>&1 || true
  "$ADB" shell input keyevent KEYCODE_HOME
  echo "enrolled 1 fingerprint (device PIN $DEVICE_PIN)"
}

# Back to a phone with no biometric, which is the condition KMO-10 #4 is about.
# Clearing the device credential takes the enrolments with it: a fingerprint
# cannot outlive the lock screen it was registered behind.
finger_clear() {
  "$ADB" shell locksettings clear --old "$DEVICE_PIN" >/dev/null 2>&1 || true
  sleep 2

  local remaining
  remaining="$(finger_count)"
  [ "${remaining:-0}" -eq 0 ] || die "still ${remaining} enrolled — clear it in Settings"
  echo "no enrolled fingerprints, no device credential"
}

case "${1:-}" in
  geo)
    [ $# -eq 3 ] || die "usage: bin/device geo <lat> <lon>"
    # NB: the emulator console takes longitude first. Swapping here so callers
    # can use the lat/lon order everything else in the codebase uses.
    "$ADB" emu geo fix "$3" "$2" >/dev/null
    echo "moved to lat=$2 lon=$3"
    ;;
  gps)
    case "${2:-}" in
      on)  "$ADB" shell cmd location set-location-enabled true;  echo "location services on" ;;
      off) "$ADB" shell cmd location set-location-enabled false; echo "location services off" ;;
      *) die "usage: bin/device gps on|off" ;;
    esac
    ;;
  net)
    case "${2:-}" in
      on)  "$ADB" shell cmd connectivity airplane-mode disable; echo "network on" ;;
      off) "$ADB" shell cmd connectivity airplane-mode enable;  echo "network off (airplane mode)" ;;
      *) die "usage: bin/device net on|off" ;;
    esac
    ;;
  slow) "$ADB" emu network speed gsm >/dev/null; "$ADB" emu network delay gprs >/dev/null; echo "network degraded to GSM/GPRS" ;;
  fast) "$ADB" emu network speed full >/dev/null; "$ADB" emu network delay none >/dev/null; echo "network restored" ;;
  perm)
    # pm grant/revoke fail silently for permissions the manifest does not
    # declare, so report per-permission rather than claiming blanket success.
    case "${2:-}" in
      grant|revoke)
        for p in "${LOCATION_PERMS[@]}"; do
          if "$ADB" shell pm "$2" "$PACKAGE" "$p" 2>&1 | grep -q .; then
            echo "  ${p##*.}: not declared in the manifest — no-op"
          else
            echo "  ${p##*.}: ${2}ed"
          fi
        done
        ;;
      reset)  "$ADB" shell pm reset-permissions "$PACKAGE" >/dev/null; echo "permissions reset to first-launch state" ;;
      # The state a second refusal leaves Android in: revoked *and* USER_FIXED,
      # after which the OS never shows the prompt again and the only way back is
      # system settings. `revoke` alone does not reach it — the permission comes
      # back as merely denied, which the app answers with the prompt rather than
      # with the settings route — so KMO-16 #8 has no other way to be driven.
      deny-forever)
        for p in "${LOCATION_PERMS[@]}"; do
          "$ADB" shell pm revoke "$PACKAGE" "$p" >/dev/null 2>&1
          "$ADB" shell pm set-permission-flags "$PACKAGE" "$p" user-fixed >/dev/null 2>&1
          echo "  ${p##*.}: denied, and the prompt will not return"
        done
        ;;
      *) die "usage: bin/device perm grant|revoke|deny-forever|reset" ;;
    esac
    ;;
  font)
    # Settings > Display > Font size. Android's largest stop is 1.3; anything
    # above that comes from "Display size", which scales density instead.
    # Applied live — a running app receives a configuration change.
    case "${2:-}" in
      "")    die "usage: bin/device font <scale>|max|reset" ;;
      max)   scale=1.3 ;;
      reset) scale=1.0 ;;
      *)     scale="$2" ;;
    esac
    "$ADB" shell settings put system font_scale "$scale"
    echo "font scale $("$ADB" shell settings get system font_scale | tr -d '\r')"
    ;;
  finger)
    case "${2:-}" in
      "")       "$ADB" emu finger touch 1 >/dev/null; echo "fingerprint presented" ;;
      enroll)   finger_enroll ;;
      clear)    finger_clear ;;
      status)   echo "enrolled fingerprints: $(finger_count)" ;;
      *) die "usage: bin/device finger [enroll|clear|status]" ;;
    esac
    ;;
  link)
    [ $# -eq 2 ] || die "usage: bin/device link <url>"
    "$ADB" shell am start -W -a android.intent.action.VIEW -d "$2" "$PACKAGE"
    ;;
  launch) "$ADB" shell monkey -p "$PACKAGE" -c android.intent.category.LAUNCHER 1 >/dev/null 2>&1; echo "launched $PACKAGE" ;;
  kill)   "$ADB" shell am force-stop "$PACKAGE"; echo "stopped $PACKAGE" ;;
  state)
    # Matched in-shell rather than through a pipe: grep -q exits on first match,
    # which SIGPIPEs the upstream stage and trips pipefail into a false negative.
    pkgs="$("$ADB" shell pm list packages 2>/dev/null | tr -d '\r')"
    case $'\n'"$pkgs"$'\n' in
      *$'\n'"package:$PACKAGE"$'\n'*) installed=yes ;;
      *) installed=no ;;
    esac
    echo "package installed: $installed"
    echo "location enabled:  $("$ADB" shell cmd location is-location-enabled 2>/dev/null | tr -d '\r')"
    echo "airplane mode:     $("$ADB" shell settings get global airplane_mode_on | tr -d '\r')"
    echo "font scale:        $("$ADB" shell settings get system font_scale | tr -d '\r')"
    echo "location perms:"
    if [ "$installed" = no ]; then
      echo "  (app not installed)"
    else
      # grep exits 1 when the manifest declares no location permissions, which
      # under set -e would abort the whole report.
      perms="$("$ADB" shell dumpsys package "$PACKAGE" 2>/dev/null \
        | grep -E 'ACCESS_(FINE|COARSE)_LOCATION.*granted=' | tr -d '\r' | sed 's/^[[:space:]]*/  /' || true)"
      # Absent until expo-location lands in KMO-16 and the manifest declares them.
      echo "${perms:-  (none declared in the manifest yet)}"
    fi
    ;;
  *) sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac

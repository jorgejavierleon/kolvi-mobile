# Copy to `.env` and adjust. `.env` is gitignored; CI supplies these as build
# secrets. `EXPO_PUBLIC_` variables are inlined into the bundle at build time, so
# nothing secret belongs in this file.

# The origin of the `ams` backend. The app appends `/api/v1` itself.
# Left unset, the app falls back to http://10.0.2.2:8000 — the Android emulator's
# route to the host machine's localhost, i.e. a locally-running `ams`.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
